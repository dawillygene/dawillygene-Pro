rules_version = '2';

// Security rules for dawillygene.com (GeneLabs Software Tz).
// Public site content is world-readable. Writes are restricted to the admin
// account so the client-side admin panel cannot be bypassed by anyone hitting
// Firestore directly with the public Firebase config.
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the verified admin account may mutate content.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'admin@dawillygene.com';
    }

    // ── Public, read-only site content ──────────────────────────────
    match /hero/{doc}         { allow read; allow write: if isAdmin(); }
    match /about/{doc}        { allow read; allow write: if isAdmin(); }
    match /services/{doc}     { allow read; allow write: if isAdmin(); }
    match /projects/{doc}     { allow read; allow write: if isAdmin(); }
    match /experience/{doc}   { allow read; allow write: if isAdmin(); }
    match /team/{doc}         { allow read; allow write: if isAdmin(); }
    match /testimonials/{doc} { allow read; allow write: if isAdmin(); }
    match /contact/{doc}      { allow read; allow write: if isAdmin(); }
    match /company/{doc}      { allow read; allow write: if isAdmin(); }
    match /navigation/{doc}   { allow read; allow write: if isAdmin(); }

    // ── Contact inquiries: anyone may submit, only admin may read ────
    match /contact_inquiries/{doc} {
      allow create: if request.resource.data.keys().hasOnly(
                        ['name', 'email', 'subject', 'message', 'createdAt', 'updatedAt'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }

    // ── Deny everything not explicitly matched above ────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
